import { NextResponse } from "next/server";
import OpenAI from "openai";

const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

type A([platform.openai.com](https://platform.openai.com/docs/quickstart?.mkv=))}
  scheduleText: string;
  supportingInfo?: string;
};

export async function POST(req: Request) {
  try {
    const body = (await req.json()) as AnalyzeScheduleRequest;
    const scheduleText = body?.scheduleText?.trim();
    const supportingInfo = body?.supportingInfo?.trim() || "";

    if (!scheduleText) {
      return NextResponse.json(
        { error: "scheduleText is required." },
        { status: 400 }
      );
    }

    const prompt = `You are analyzing a student's class schedule.

Input schedule:
${scheduleText}

Additional context that may include syllabus details, catalog descriptions, prior student comments, or workload notes:
${supportingInfo || "None provided."}

Follow these rules exactly:
1. Read the schedule and identify each class.
2. Approximate each credit hour as 4 hours of work per week.
3. Calculate the total time required by the full schedule per week, but do NOT show the calculation.
4. For each class, rate the difficulty as:
   - 1 = 🔵
   - 2 = 🟢
   - 3 = 🟡
   Base the rating on expected workload synthesized from syllabus information and student responses when those are present in the provided input.
5. For each class, show ONLY:
   - the rating emoji
   - one sentence summary
   Do not show extra details for the class.
6. Add together all class ratings and then assign a final schedule rating using this exact scale:
   - 1 to 5 = 🔥 (very easy)
   - 6 to 10 = 🔥🔥 (easy)
   - 11 to 15 = 🔥🔥🔥 (moderate)
   - 16 to 20 = 🔥🔥🔥🔥 (difficult)
   - 20+ = 🔥🔥🔥🔥🔥 (very difficult)
7. Show ONLY the final schedule rating and its label, not the math.
8. Give a short pros list and a short cons list with up to 5 bullet points each.
9. Put the per-class ratings section after the total weekly time required and before the pros and cons.
10. Keep the answer concise and clean.
11. Do not mention missing data, uncertainty, or calculations unless the input is too incomplete to identify classes.

Return your answer in exactly this structure:

Total time required: <final weekly total only>

Class ratings:
<Class Name>: <emoji> <one sentence summary>
<Class Name>: <emoji> <one sentence summary>

Final schedule rating: <flame emoji(s)> (<label>)

Pros:
- <bullet>

Cons:
- <bullet>`;

    const response = await client.responses.create({
      model: "gpt-5.4",
      input: prompt,
    });

    return NextResponse.json({
      result: response.output_text,
    });
  } catch (error) {
    console.error("Schedule analysis failed:", error);

    return NextResponse.json(
      { error: "Failed to analyze schedule." },
      { status: 500 }
    );
  }
}
